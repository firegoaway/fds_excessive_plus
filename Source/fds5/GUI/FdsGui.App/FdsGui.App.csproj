  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FdsGui.Core\FdsGui.Core.csproj" />
    <ProjectReference Include="..\FdsGui.Viewport\FdsGui.Viewport.csproj" />
  </ItemGroup>

</Project>
