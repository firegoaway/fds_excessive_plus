<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FdsGui.App.ViewModels"
             x:Class="FdsGui.App.Views.PropertyPanelView">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="Bold" Margin="8,4"/>

        <!-- Placeholder when nothing selected -->
        <TextBlock Text="{Binding PlaceholderText}"
                   Foreground="Gray" FontStyle="Italic" Margin="8,4"
                   IsVisible="{Binding !HasSelection}"/>

        <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Margin="8,4" Spacing="6">

                <!-- === Wall section === -->
                <StackPanel IsVisible="{Binding IsWallSelected}">
                    <TextBlock Text="Wall" FontWeight="Bold" FontSize="14"/>
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding WallName}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Thickness (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding Thickness}" Minimum="10" Maximum="2000" Increment="10" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Height (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding Height}" Minimum="0.1" Maximum="100" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bottom Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding BottomZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Material" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding Material}" ItemsSource="{Binding Materials}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Color (hex)" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding ColorHex}" />
                    </StackPanel>
                </StackPanel>

                <!-- === Door section === -->
                <StackPanel IsVisible="{Binding IsDoorSelected}">
                    <TextBlock Text="Door" FontWeight="Bold" FontSize="14"/>
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding DoorName}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Width (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding DoorWidth}" Minimum="100" Maximum="3000" Increment="50" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Height (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding DoorHeight}" Minimum="500" Maximum="4000" Increment="50" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bottom Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding DoorBottomZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Rotation (deg)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding DoorRotation}" Minimum="-360" Maximum="360" Increment="5" FormatString="F1" />
                    </StackPanel>
                </StackPanel>

                <!-- === Slab section === -->
                <StackPanel IsVisible="{Binding IsSlabSelected}">
                    <TextBlock Text="Slab" FontWeight="Bold" FontSize="14"/>
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding SlabName}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Thickness (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding SlabThickness}" Minimum="10" Maximum="2000" Increment="10" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bottom Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding SlabBottomZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                </StackPanel>

                <!-- === Stair section === -->
                <StackPanel IsVisible="{Binding IsStairSelected}">
                    <TextBlock Text="Stair" FontWeight="Bold" FontSize="14"/>
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding StairName}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Height (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding StairHeight}" Minimum="0.1" Maximum="100" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Width (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding StairWidth}" Minimum="300" Maximum="5000" Increment="50" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bottom Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding StairBottomZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Step Height (mm)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding StairStepHeight}" Minimum="50" Maximum="500" Increment="10" FormatString="F0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Direction" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedIndex="{Binding StairDirectionIndex}"
                                  ItemsSource="{Binding DirectionOptions}" />
                    </StackPanel>
                </StackPanel>

                <!-- === Room section === -->
                <StackPanel IsVisible="{Binding IsRoomSelected}">
                    <TextBlock Text="Room" FontWeight="Bold" FontSize="14"/>
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding RoomName}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bottom Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding RoomBottomZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Top Z (m)" FontSize="11" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding RoomTopZ}" Minimum="-100" Maximum="1000" Increment="0.1" FormatString="F2" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Vertices" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding RoomPointCount}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Mode" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding RoomMode}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Common action buttons -->
                <Separator Margin="0,8"/>
                <TextBlock Text="Transform" FontWeight="Bold" FontSize="12"/>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Move (G)" Margin="2" MinWidth="60"/>
                    <Button Content="Rotate (R)" Margin="2" MinWidth="60"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Mirror H" Margin="2" MinWidth="60"/>
                    <Button Content="Mirror V" Margin="2" MinWidth="60"/>
                </WrapPanel>
                <Separator Margin="0,8"/>
                <Button Content="Delete (X)" Margin="2" Background="#CC3333" Foreground="White"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
