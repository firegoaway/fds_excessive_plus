<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FdsGui.App.Controls"
        xmlns:views="using:FdsGui.App.Views"
        x:Class="FdsGui.App.Views.MainWindow"
        Title="FDS Building Editor"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="600">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Open..." InputGesture="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xport">
                    <MenuItem Header="Export .fds"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Project _Settings..."/>
                <Separator/>
                <MenuItem Header="E_xit" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnMenuUndo"/>
                <MenuItem Header="_Redo" InputGesture="Ctrl+Shift+Z" Click="OnMenuRedo"/>
                <Separator/>
                <MenuItem Header="_Delete" InputGesture="Delete" Click="OnMenuDelete"/>
                <MenuItem Header="D_uplicate" InputGesture="Ctrl+D"/>
                <Separator/>
                <MenuItem Header="Select _All" InputGesture="Ctrl+A"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Fit _All" InputGesture="Home"/>
                <MenuItem Header="_Top View" InputGesture="NumPad7"/>
                <MenuItem Header="_Front View" InputGesture="NumPad1"/>
                <MenuItem Header="_Right View" InputGesture="NumPad3"/>
                <Separator/>
                <MenuItem Header="Toggle _Perspective/Ortho" InputGesture="NumPad5"/>
                <Separator/>
                <MenuItem Header="_Snap to Grid" InputGesture="F4" Click="OnMenuSnapToggle"/>
            </MenuItem>
            <MenuItem Header="_Simulate">
                <MenuItem Header="_Run Simulation" InputGesture="F5"/>
                <MenuItem Header="_Stop"/>
                <Separator/>
                <MenuItem Header="View _Results"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" InputGesture="F1"/>
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
            <Button Content="New" Margin="2,0"/>
            <Button Content="Open" Margin="2,0"/>
            <Button Content="Save" Margin="2,0"/>
            <Separator/>
            <Button Content="Run" Margin="2,0"/>
            <Button Content="Stop" Margin="2,0"/>
            <Button Content="Results" Margin="2,0"/>
            <Separator/>
            <Button Content="Validate" Margin="2,0"/>
            <Separator/>
            <Button Content="Select" Margin="2,0" Name="BtnSelect"/>
            <Button Content="Wall (W)" Margin="2,0" Name="BtnWall"/>
            <Button Content="Door (D)" Margin="2,0" Name="BtnDoor"/>
            <Button Content="Slab (P)" Margin="2,0" Name="BtnSlab"/>
            <Button Content="Stair (L)" Margin="2,0" Name="BtnStair"/>
            <Button Content="Room (M)" Margin="2,0" Name="BtnRoom"/>
            <Separator/>
            <Button Content="Move (G)" Margin="2,0" Name="BtnMove"/>
            <Button Content="Rotate (R)" Margin="2,0" Name="BtnRotate"/>
            <Separator/>
            <Button Content="Mirror H" Margin="2,0" Name="BtnMirrorH"/>
            <Button Content="Mirror V" Margin="2,0" Name="BtnMirrorV"/>
            <Separator/>
            <Button Content="Snap: ON" Margin="2,0" Name="BtnSnapToggle"/>
            <Button Content="Grid+" Margin="2,0" Name="BtnGridPlus"/>
            <Button Content="Grid-" Margin="2,0" Name="BtnGridMinus"/>
        </StackPanel>

        <!-- Status Bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,2">
            <TextBlock Text="Ready" Name="StatusText"/>
            <TextBlock Text="  |  Floor: 1/1" Name="FloorInfo" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Walls: 0" Name="WallCount" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Doors: 0" Name="DoorCount" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Slabs: 0" Name="SlabCount" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Stairs: 0" Name="StairCount" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Rooms: 0" Name="RoomCount" Margin="20,0,0,0"/>
            <TextBlock Text="  |  Grid: 0.5m" Name="GridInfo" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Main Content: 3-panel layout -->
        <Grid ColumnDefinitions="250,*,280">

            <!-- Left Panel: Hierarchy Tree -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="Hierarchy" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center"/>
                        <Button Content="+" Margin="8,0,2,0" Name="BtnAddFloor" ToolTip.Tip="Add Floor"
                                FontSize="14" Padding="4,0" MinWidth="28"/>
                        <Button Content="Show All" Margin="2,0" Name="BtnShowAllFloors"
                                FontSize="10" Padding="4,0"/>
                    </StackPanel>
                    <TreeView Name="HierarchyTree"/>
                </DockPanel>
            </Border>

            <!-- Center: Viewport -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="2">
                <controls:GlViewportControl Name="Viewport"/>
            </Border>

            <!-- Right Panel: Properties -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="2">
                <views:PropertyPanelView Name="PropertyPanel"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
