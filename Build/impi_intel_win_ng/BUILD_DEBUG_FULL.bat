@echo off
echo === FULL DEBUG BUILD START %DATE% %TIME% ===
call "D:\Intel\oneAPI\setvars.bat" intel64 >nul 2>&1
cd /d "%~dp0"
set I_MPI_ROOT=D:\Intel\oneAPI\mpi\latest
set MKLLIBDIR=D:\Intel\oneAPI\mkl\latest\lib
set FFLAGS=-D_WIN32 /Od /nologo /debug:all /Z7 /extend-source:132 /warn:unused /traceback /check:all /wrap-margin- /assume:nounderscore /I"%I_MPI_ROOT%\include\mpi" /I"%I_MPI_ROOT%\include" /I"%MKLROOT%\include" -fpp -DGITHASH_PP="debug" -DGITDATE_PP="2026-10-21" -DBUILDDATE_PP="2026-10-21"
set SRCDIR=..\..\Source\fds5ng

echo Compiling prec.f90...
ifx %FFLAGS% -c %SRCDIR%\prec.f90 || goto fail
